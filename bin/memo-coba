#!/usr/bin/env bash
# Menjalankan pendeteksi isyarat dengan umpan balik langsung, TANPA mengubah
# apa pun. Untuk mencoba-coba pose sampai terbiasa.
AKAR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
systemctl --user stop memo-tangan.service 2>/dev/null
cat <<'PANDUAN'
Mode coba — tidak ada yang benar-benar diubah.

  telapak terbuka   aktifkan kendali (5 detik)
  jempol            volume naik      (tahan = berulang)
  telunjuk          volume turun     (tahan = berulang)
  dua jari          tab berikutnya
  tiga jari         tab sebelumnya
  kepalan 1,5 detik tutup tab

Ctrl+C untuk berhenti. Setelah selesai, nyalakan lagi layanannya dengan:
  systemctl --user start memo-tangan.service

PANDUAN
exec "$AKAR/.venv/bin/python" "$AKAR/bin/memo-tangan.py" --tanpa-aksi --verbose
