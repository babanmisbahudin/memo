#!/usr/bin/env bash
# Menyintesis kalimat tetap Memo lebih awal, supaya pemicu isyarat tidak
# menunggu sintesis saat dipakai. Aman dijalankan berulang: yang sudah ada
# di cache dilewati oleh bin/memo sendiri.
set -uo pipefail
AKAR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

KALIMAT=(
    "Hai Baban, ada apa?"
    "Damai juga, Baban."
    "Siap, Baban."
    "Halo Baban"
    "Sampai jumpa, Baban."
)

for k in "${KALIMAT[@]}"; do
    printf 'memanaskan: %s\n' "$k"
    MEMO_DIAM=1 "$AKAR/memo" --hanya-cache "$k"
done
echo "selesai"
